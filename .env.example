# ── App ──
APP_NAME=Industrial Brain
VERSION=1.0.0
DEBUG=true

# ── PostgreSQL ──
POSTGRES_USER=epic
POSTGRES_PASSWORD=epic_secret
POSTGRES_DB=industrial_brain
DATABASE_URL=postgresql+asyncpg://epic:epic_secret@postgres:5432/industrial_brain

# ── Neo4j ──
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=industrial_brain_neo4j
NEO4J_AUTH=neo4j/industrial_brain_neo4j

# ── Qdrant ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── JWT Auth ──
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LLM APIs ──
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# ── File Storage ──
UPLOAD_DIR=./uploads
